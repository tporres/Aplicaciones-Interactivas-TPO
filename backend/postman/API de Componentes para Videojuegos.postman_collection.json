{
  "info": {
    "name": "API de componentes para videojuegos",
    "description": "Colección para probar el servidor del TPO. Ejecutar db:setup e iniciar la API antes de comenzar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "inquiryId", "value": "" },
    { "key": "resetToken", "value": "" }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "Estado general",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
        },
        {
          "name": "Disponibilidad",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health/ready" }
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('administrador creado', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Administrador\",\n  \"lastName\": \"Postman\",\n  \"email\": \"postman.administrador@example.com\",\n  \"phone\": \"+54 11 5555 1234\",\n  \"password\": \"ClaveSegura123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('inicio de sesión exitoso', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.administrador@example.com\",\n  \"password\": \"ClaveSegura123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Consultar perfil",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/profile"
          }
        },
        {
          "name": "Modificar perfil",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+54 11 4000 9999\"\n}" },
            "url": "{{baseUrl}}/api/v1/profile"
          }
        },
        {
          "name": "Solicitar recuperación de contraseña",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('recuperación aceptada', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "if (body.data.resetToken) pm.collectionVariables.set('resetToken', body.data.resetToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman.administrador@example.com\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password"
          }
        },
        {
          "name": "Restablecer contraseña",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"NuevaClaveSegura456!\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/reset-password"
          }
        },
        {
          "name": "Iniciar sesión con la contraseña nueva",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman.administrador@example.com\",\n  \"password\": \"NuevaClaveSegura456!\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Comercio",
      "item": [
        {
          "name": "Crear o reemplazar información institucional",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pixel Forge Componentes\",\n  \"description\": \"Componentes para videojuegos y asesoramiento especializado.\",\n  \"address\": \"Av. Corrientes 1234, CABA\",\n  \"phone\": \"+54 11 4444 4444\",\n  \"socialLinks\": {\n    \"instagram\": \"https://instagram.com/pixelforge\"\n  },\n  \"openingHours\": \"Lunes a sábado de 10:00 a 19:00\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/store"
          }
        },
        {
          "name": "Consultar información institucional",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/store" }
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Listar categorías",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories" }
        },
        {
          "name": "Crear categoría",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('categoryId', pm.response.json().data.id);"] }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Componentes de Postman\",\n  \"description\": \"Categoría creada durante la prueba manual\"\n}" },
            "url": "{{baseUrl}}/api/v1/categories"
          }
        },
        {
          "name": "Consultar categoría",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          }
        },
        {
          "name": "Modificar categoría",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Categoría actualizada desde Postman\"\n}" },
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          }
        },
        {
          "name": "Eliminar categoría",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "Productos públicos",
      "item": [
        {
          "name": "Buscar y filtrar productos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products?q=videojuegos&categoryId={{categoryId}}&availability=in_stock&sort=price_desc&page=1&limit=20"
          }
        },
        {
          "name": "Consultar producto",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products/{{productId}}" }
        }
      ]
    },
    {
      "name": "Administración de productos",
      "item": [
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('productId', pm.response.json().data.id);"] }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"name\": \"GPU para videojuegos de Postman\",\n  \"description\": \"Producto para videojuegos creado desde Postman\",\n  \"imageUrl\": \"https://placehold.co/800x600?text=Postman+GPU\",\n  \"price\": 999999.99,\n  \"availability\": \"in_stock\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/products"
          }
        },
        {
          "name": "Consultar producto como administrador",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}"
          }
        },
        {
          "name": "Listar productos inactivos",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/products?isActive=false&page=1&limit=20"
          }
        },
        {
          "name": "Desactivar producto",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false,\n  \"availability\": \"out_of_stock\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}"
          }
        },
        {
          "name": "Activar producto",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": true,\n  \"availability\": \"in_stock\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}"
          }
        },
        {
          "name": "Eliminar producto",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Consultas",
      "item": [
        {
          "name": "Enviar consulta",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('inquiryId', pm.response.json().data.id);"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Visitante de Postman\",\n  \"email\": \"visitante@example.com\",\n  \"phone\": null,\n  \"subject\": \"Consulta sobre disponibilidad\",\n  \"message\": \"¿Tienen disponibilidad inmediata?\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/inquiries"
          }
        },
        {
          "name": "Consultar consulta",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/inquiries/{{inquiryId}}"
          }
        },
        {
          "name": "Listar consultas pendientes",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/inquiries?status=pending&page=1&limit=20"
          }
        },
        {
          "name": "Marcar consulta como respondida",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"answered\"\n}" },
            "url": "{{baseUrl}}/api/v1/inquiries/{{inquiryId}}/status"
          }
        },
        {
          "name": "Eliminar consulta",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/inquiries/{{inquiryId}}"
          }
        }
      ]
    }
  ]
}
